class Solution:
    def search(self, nums, target):

        left = 0
        right = len(nums) - 1

        while left <= right:

            mid = (left + right) // 2

            if nums[mid] == target:
                return mid

            elif nums[mid] < target:
                left = mid + 1

            else:
                right = mid - 1

        return -1


# User input
nums = list(map(int, input("Enter numbers: ").split()))
target = int(input("Enter target: "))

obj = Solution()

print("Answer:", obj.search(nums, target))