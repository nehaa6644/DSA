class Solution:
    def findPeakElement(self, nums):
        left = 0
        right = len(nums) - 1

        while left < right:
            mid = (left + right) // 2

            if nums[mid] < nums[mid + 1]:
                left = mid + 1
            else:
                right = mid

        return left


# Take input from user
nums = list(map(int, input("Enter numbers: ").split()))

# Create object
obj = Solution()

# Call the function
answer = obj.findPeakElement(nums)

print("Peak index:", answer)
print("Peak element:", nums[answer])